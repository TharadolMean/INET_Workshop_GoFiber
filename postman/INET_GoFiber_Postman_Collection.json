    {
      "name": "04 - Exercise 6 Registration Validation",
      "description": "POST JSON ผ่าน Struct และ go-playground/validator/v10",
      "item": [
        {
          "name": "01 - Valid Register → 200",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/register",
            "description": "Exercise 6 JSON Body ผ่าน BodyParser และ validator/v10",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"username\": \"mean123\",\n  \"password\": \"Test123456\",\n  \"line_id\": \"meanline\",\n  \"phone\": \"0812345678\",\n  \"business_type\": \"Technology\",\n  \"website_name\": \"myshop\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Registration validation passed\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.success).to.eql(true);",
                  "    pm.expect(data.data.email).to.eql(\"test@example.com\");",
                  "    pm.expect(data.data.username).to.eql(\"mean123\");",
                  "});",
                  "",
                  "pm.test(\"Password not echoed in response\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(JSON.stringify(data)).not.to.include(\"Test123456\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Invalid Register → 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/register",
            "description": "ส่ง Email/Username/Password/Phone/BusinessType/WebsiteName ที่ผิดรูปแบบ",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wrong-email\",\n  \"username\": \"user@name\",\n  \"password\": \"123\",\n  \"line_id\": \"\",\n  \"phone\": \"abc\",\n  \"business_type\": \"\",\n  \"website_name\": \"a\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Multiple validation errors\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.success).to.eql(false);",
                  "    pm.expect(data.errors).to.have.property(\"email\");",
                  "    pm.expect(data.errors).to.have.property(\"username\");",
                  "    pm.expect(data.errors).to.have.property(\"password\");",
                  "    pm.expect(data.errors).to.have.property(\"phone\");",
                  "    pm.expect(data.errors).to.have.property(\"business_type\");",
                  "    pm.expect(data.errors).to.have.property(\"website_name\");",
                  "});"
                ]
              }
            }
          ]
        },
