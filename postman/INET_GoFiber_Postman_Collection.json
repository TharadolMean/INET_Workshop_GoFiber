      "name": "01 - Exercise 5.0 Basic Auth",
      "description": "ตรวจ Basic Auth: ไม่ส่งหรือส่งผิดต้องได้ 401",
      "item": [
        {
          "name": "01 - Without Basic Auth → 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/fact/5",
            "description": "ไม่ส่ง Basic Auth เพื่อทดสอบ Middleware",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Unauthorized JSON\", function () {",
                  "    pm.expect(pm.response.json().success).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
